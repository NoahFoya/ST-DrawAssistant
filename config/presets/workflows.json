[
  {
    "id": "comfyui_checkpoint_basic",
    "name": "基础全量模型工作流（无weilin）",
    "description": "基于 CheckpointLoaderSimple 的原生基础全量模型工作流，无 WeiLin 插件，LoRA 标签不生效",
    "data": {
      "workflow": {
        "3": {
          "inputs": {
            "seed": "%seed%",
            "steps": "%steps%",
            "cfg": "%cfg%",
            "sampler_name": "%sampler_name%",
            "scheduler": "%scheduler%",
            "denoise": 1,
            "model": [
              "4",
              0
            ],
            "positive": [
              "6",
              0
            ],
            "negative": [
              "7",
              0
            ],
            "latent_image": [
              "5",
              0
            ]
          },
          "class_type": "KSampler",
          "_meta": {
            "title": "K采样器"
          }
        },
        "4": {
          "inputs": {
            "ckpt_name": "%basemodel_name%"
          },
          "class_type": "CheckpointLoaderSimple",
          "_meta": {
            "title": "Checkpoint加载器"
          }
        },
        "5": {
          "inputs": {
            "width": "%width%",
            "height": "%height%",
            "batch_size": 1
          },
          "class_type": "EmptyLatentImage",
          "_meta": {
            "title": "空Latent图像"
          }
        },
        "6": {
          "inputs": {
            "text": "%prompt%",
            "clip": [
              "4",
              1
            ]
          },
          "class_type": "CLIPTextEncode",
          "_meta": {
            "title": "正向提示词编码"
          }
        },
        "7": {
          "inputs": {
            "text": "%negative_prompt%",
            "clip": [
              "4",
              1
            ]
          },
          "class_type": "CLIPTextEncode",
          "_meta": {
            "title": "负向提示词编码"
          }
        },
        "8": {
          "inputs": {
            "samples": [
              "3",
              0
            ],
            "vae": [
              "4",
              2
            ]
          },
          "class_type": "VAEDecode",
          "_meta": {
            "title": "VAE解码"
          }
        },
        "9": {
          "inputs": {
            "filename_prefix": "ST-Draw-",
            "images": [
              "8",
              0
            ]
          },
          "class_type": "SaveImage",
          "_meta": {
            "title": "保存图像"
          }
        }
      }
    }
  },
  {
