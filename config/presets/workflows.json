[
  {
    "id": "workflow_comfyui_native_checkpoint",
    "name": "默认 Checkpoint 模型文生图 (原生)",
    "description": "基于 Checkpoint 整合模型的原生 ComfyUI 文生图工作流，支持自动动态串联原生 LoraLoader 加载所选 LoRA",
    "data": {
      "workflow": {
        "3": {
          "inputs": {
            "seed": "%seed%",
            "steps": "%steps%",
            "cfg": "%cfg%",
            "sampler_name": "%sampler_name%",
            "scheduler": "%scheduler%",
            "denoise": 1,
            "model": [
              "4",
              0
            ],
            "positive": [
              "6",
              0
            ],
            "negative": [
              "7",
              0
            ],
            "latent_image": [
              "5",
              0
            ]
          },
          "class_type": "KSampler",
          "_meta": {
            "title": "K 采样器"
          }
        },
        "4": {
          "inputs": {
            "ckpt_name": "%basemodel_name%"
          },
          "class_type": "CheckpointLoaderSimple",
          "_meta": {
            "title": "Checkpoint 模型加载器"
          }
        },
        "5": {
          "inputs": {
            "width": "%width%",
            "height": "%height%",
            "batch_size": 1
          },
          "class_type": "EmptyLatentImage",
          "_meta": {
            "title": "空 Latent 图像"
          }
        },
        "6": {
          "inputs": {
            "text": "%prompt%",
            "clip": [
              "4",
              1
            ]
          },
          "class_type": "CLIPTextEncode",
          "_meta": {
            "title": "正向条件编码"
          }
        },
        "7": {
          "inputs": {
            "text": "%negative_prompt%",
            "clip": [
              "4",
              1
            ]
          },
          "class_type": "CLIPTextEncode",
          "_meta": {
            "title": "负向条件编码"
          }
        },
        "8": {
          "inputs": {
            "samples": [
              "3",
              0
            ],
            "vae": [
              "4",
              2
            ]
          },
          "class_type": "VAEDecode",
          "_meta": {
            "title": "VAE 解码器"
          }
        },
        "9": {
          "inputs": {
            "filename_prefix": "ST-Draw-",
            "images": [
              "8",
              0
            ]
          },
          "class_type": "SaveImage",
          "_meta": {
            "title": "保存图像"
          }
        }
      }
    }
  },
  {
    "id": "workflow_comfyui_native_unet",
    "name": "默认 UNet 模型文生图 (原生)",
    "description": "基于 UNet、CLIP 与 VAE 分立加载的原生 ComfyUI 文生图工作流，支持自动串联原生 LoraLoader；Flux / SD3 / Qwen 等特定架构请在「打开蓝图」调整 CLIPLoader 类型",
    "data": {
      "workflow": {
        "3": {
          "inputs": {
            "seed": "%seed%",
            "steps": "%steps%",
            "cfg": "%cfg%",
            "sampler_name": "%sampler_name%",
            "scheduler": "%scheduler%",
            "denoise": 1,
            "model": [
              "4",
              0
            ],
            "positive": [
              "6",
              0
            ],
            "negative": [
              "7",
              0
            ],
            "latent_image": [
              "5",
              0
            ]
          },
          "class_type": "KSampler",
          "_meta": {
            "title": "K 采样器"
          }
        },
        "4": {
          "inputs": {
            "unet_name": "%basemodel_name%",
            "weight_dtype": "default"
          },
          "class_type": "UNETLoader",
          "_meta": {
            "title": "UNet 模型加载器"
          }
        },
        "5": {
          "inputs": {
            "width": "%width%",
            "height": "%height%",
            "batch_size": 1
          },
          "class_type": "EmptyLatentImage",
          "_meta": {
            "title": "空 Latent 图像"
          }
        },
        "6": {
          "inputs": {
            "text": "%prompt%",
            "clip": [
              "10",
              0
            ]
          },
          "class_type": "CLIPTextEncode",
          "_meta": {
            "title": "正向条件编码"
          }
        },
        "7": {
          "inputs": {
            "text": "%negative_prompt%",
            "clip": [
              "10",
              0
            ]
          },
          "class_type": "CLIPTextEncode",
          "_meta": {
            "title": "负向条件编码"
          }
        },
        "8": {
          "inputs": {
            "samples": [
              "3",
              0
            ],
            "vae": [
              "11",
              0
            ]
          },
          "class_type": "VAEDecode",
          "_meta": {
            "title": "VAE 解码器"
          }
        },
        "9": {
          "inputs": {
            "filename_prefix": "ST-Draw-",
            "images": [
              "8",
              0
            ]
          },
          "class_type": "SaveImage",
          "_meta": {
            "title": "保存图像"
          }
        },
        "10": {
          "inputs": {
            "clip_name": "%clip_name%",
            "type": "stable_diffusion",
            "device": "default"
          },
          "class_type": "CLIPLoader",
          "_meta": {
            "title": "CLIP 模型加载器"
          }
        },
        "11": {
          "inputs": {
            "vae_name": "%vae_name%"
          },
          "class_type": "VAELoader",
          "_meta": {
            "title": "VAE 模型加载器"
          }
        }
      }
    }
  }
]
