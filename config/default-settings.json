    "characterMacros": [
      {
        "id": "char_macro_closeup",
        "name": "closeup",
        "description": "面部或头部近景特写时调用，包含发型发色、五官特征与常戴配饰；如需突出兽耳、犄角等特征可追加 -features 后缀。",
        "targetParts": [
          "hair",
          "face",
          "accessories"
        ]
      },
      {
        "id": "char_macro_upper",
        "name": "upper",
        "description": "胸腰以上半身构图时调用，包含头面部、肩颈上身、胸部轮廓、双手及常戴配饰；如需突出耳尾翅角等特征可追加 -features 后缀，衣物破损或敞开时可按需补充状态标签。",
        "targetParts": [
          "hair",
          "face",
          "chest",
          "upper_body",
          "hands",
          "accessories"
        ]
      },
      {
        "id": "char_macro_cowboy",
        "name": "cowboy",
        "description": "膝上七分身构图时调用，在半身基础上增加腰腹线条与臀部轮廓；如需展现尾巴或翅膀等特征可追加 -features 后缀。",
        "targetParts": [
          "hair",
          "face",
          "chest",
          "upper_body",
          "waist",
          "hips",
          "hands",
          "accessories"
        ]
      },
      {
        "id": "char_macro_full",
        "name": "full",
        "description": "全身站姿、走动或大场景构图时调用，包含整体身型体态、耳尾翅角等特征及全身部位；亲密或裸露场景可追加 -privates 或 -intimate 后缀。",
        "targetParts": [
          "appearance",
          "hair",
          "face",
          "features",
          "chest",
          "upper_body",
          "waist",
          "hips",
          "legs",
          "feet",
          "hands",
          "accessories"
        ]
      },
      {
        "id": "char_macro_intimate",
        "name": "intimate",
        "description": "画面聚焦胸部细节、亲密接触或私密特写时调用；可单独使用，也可与全身等景别宏组合使用（如 $角色名-full-intimate$）。",
        "targetParts": [
          "chest",
          "privates"
        ]
      }
    ],
    "outfitMacros": [
      {
        "id": "outfit_macro_closeup",
        "name": "closeup",
        "description": "头部近景特写时配合角色宏调用，包含头饰与随身配饰；若角色未佩戴头饰则无需调用。",
        "targetParts": [
          "headwear",
          "accessories"
        ]
      },
      {
        "id": "outfit_macro_upper",
        "name": "upper",
        "description": "半身构图时配合角色宏调用，包含头饰、上衣、手套腕饰与服装配饰；如仅穿内衣或上衣敞开，可改用对应部位后缀或手写状态标签。",
        "targetParts": [
          "headwear",
          "top",
          "handwear",
          "accessories"
        ]
      },
      {
        "id": "outfit_macro_cowboy",
        "name": "cowboy",
