        "targetParts": [
          "headwear",
          "top",
          "bottom",
          "handwear",
          "accessories"
        ]
      },
      {
        "id": "outfit_macro_full",
        "name": "full",
        "description": "全身穿搭构图时配合角色宏调用，包含整体风格、头饰、上下装、手套、袜类、鞋靴与配饰；赤足时可手写 barefoot 替代鞋靴。",
        "targetParts": [
          "style",
          "headwear",
          "top",
          "bottom",
          "handwear",
          "socks",
          "shoes",
          "accessories"
        ]
      },
      {
        "id": "outfit_macro_intimate",
        "name": "intimate",
        "description": "外衣脱去、仅穿贴身衣物或衣衫半褪时调用，展开内衣裤标签；可直接与角色宏组合调用（如 $角色名-upper$, $服装名-intimate$ 或部位后缀 $服装名-underwear$）。",
        "targetParts": [
          "underwear"
        ]
      }
