        "description": "胸腰以上半身景别配合角色调用，包含头饰、上装衣领与袖口、手套腕饰与服饰配件；若仅穿上衣或外套敞开可按需叠加状态标签。",
        "targetParts": [
          "headwear",
          "top",
          "handwear",
          "accessories"
        ]
      },
      {
        "id": "outfit_macro_cowboy",
        "name": "cowboy",
        "description": "膝上七分身景别配合角色调用，包含头饰、上装、裙装裤装、手套腕饰与服饰配件；支持按需追加特定部位变量或破损状态词。",
        "targetParts": [
          "headwear",
          "top",
          "bottom",
          "handwear",
          "accessories"
        ]
      },
      {
        "id": "outfit_macro_full",
        "name": "full",
        "description": "整套外穿服饰全身景别配合角色调用，包含整体设计风格、头饰、上下装、手套、袜子、鞋靴与服饰配件；若脱鞋赤足可手写 barefoot 覆盖鞋靴。",
        "targetParts": [
          "style",
          "headwear",
          "top",
          "bottom",
          "handwear",
          "socks",
          "shoes",
          "accessories"
        ]
      },
      {
        "id": "outfit_macro_intimate",
