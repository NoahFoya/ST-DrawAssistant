# 统一换行符为 LF
* text=auto eol=lf

# 源码与文本配置
*.ts text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.tar.gz binary

# 发布归档排除
.gitattributes export-ignore
.gitignore export-ignore
